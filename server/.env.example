NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Local values: run `npx supabase status` after `npx supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
# Public anon/publishable key. The API forwards each user's token so RLS applies.
SUPABASE_ANON_KEY=

RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# AI (optional locally: without a key the API runs and AI routes return 503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=30000
# Per-user limit on AI routes
RATE_LIMIT_MAX_REQUESTS=10
